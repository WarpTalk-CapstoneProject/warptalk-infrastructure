# ====================================================================
# WarpTalk Infrastructure — Environment Variables
# Copy to .env and fill in real values
# ====================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=warptalk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD>

# ── Per-Service DB Users ─────────────────────────────────────────────
AUTH_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
WORKSPACE_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
MEETING_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
TRANSCRIPT_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
TRANSLATION_ROOM_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
SUBSCRIPTION_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
NOTIFICATION_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
ASSISTANT_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
MONITOR_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>

# ── Redis ────────────────────────────────────────────────────────────
REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD>

# ── RabbitMQ ─────────────────────────────────────────────────────────
RABBITMQ_USERNAME=warptalk
RABBITMQ_PASSWORD=<GENERATE_SECURE_PASSWORD>
RABBITMQ_VHOST=/

# ── JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=<GENERATE_SECURE_PASSWORD_MIN_64_CHARS>
JWT_ISSUER=WarpTalk.AuthService
JWT_AUDIENCE=WarpTalk
INTERNAL_GRPC_SECRET=<GENERATE_INDEPENDENT_SECURE_PASSWORD_MIN_64_CHARS>

# Gateway rate-limit window. Keep production defaults; raise explicitly only
# in an isolated staging load-test environment.
RATE_LIMIT_IP_PER_WINDOW=300
RATE_LIMIT_USER_PER_WINDOW=180
RATE_LIMIT_WORKSPACE_PER_WINDOW=1000
RATE_LIMIT_LOGIN_PER_WINDOW=5
RATE_LIMIT_INBOX_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Stripe Sandbox (Billing owns checkout, subscription and credits) ─
STRIPE_SECRET_KEY=<STRIPE_SANDBOX_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_SANDBOX_WEBHOOK_SECRET>
STRIPE_SUCCESS_URL=http://localhost:3000/workspace/payment/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/workspace/payment/plans

# ── LiveKit Cloud ───────────────────────────────────────────────────
LIVEKIT_URL=wss://<PROJECT_SUBDOMAIN>.livekit.cloud
LIVEKIT_API_KEY=<LIVEKIT_CLOUD_API_KEY>
LIVEKIT_API_SECRET=<LIVEKIT_CLOUD_API_SECRET>
FRONTEND_LIVEKIT_URL=wss://<PROJECT_SUBDOMAIN>.livekit.cloud

# LiveKit Cloud Egress recording output (S3-compatible HTTPS storage)
LIVEKIT_EGRESS_S3_ACCESS_KEY=<S3_ACCESS_KEY>
LIVEKIT_EGRESS_S3_SECRET=<S3_SECRET_KEY>
LIVEKIT_EGRESS_S3_BUCKET=warptalk-recordings
LIVEKIT_EGRESS_S3_REGION=ap-southeast-1
LIVEKIT_EGRESS_S3_ENDPOINT=https://<S3_COMPATIBLE_ENDPOINT>

# ── Self-host fallback only (`docker compose --profile selfhost`) ───
TURN_SECRET=<GENERATE_SECURE_PASSWORD>
TURN_REALM=warptalk.io.vn

# ── CORS ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://warptalk.io.vn
APP_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# ── Observability ────────────────────────────────────────────────────
SEQ_API_KEY=
SEQ_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>
GRAFANA_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD>

# Operator-maintained contract rates for estimates and alerts. These are not
# customer billing rates and must be updated whenever a provider contract changes.
AI_COST_STT_USD_PER_MINUTE=<SET_CONTRACT_RATE>
AI_COST_TRANSLATION_USD_PER_MINUTE=<SET_CONTRACT_RATE>
AI_COST_TTS_USD_PER_MINUTE=<SET_CONTRACT_RATE>
AI_COST_VOICE_CLONE_USD_PER_MINUTE=<SET_CONTRACT_RATE>
AI_BUDGET_STT_USD=<SET_MONTHLY_BUDGET>
AI_BUDGET_TRANSLATION_USD=<SET_MONTHLY_BUDGET>
AI_BUDGET_TTS_USD=<SET_MONTHLY_BUDGET>
AI_BUDGET_VOICE_CLONE_USD=<SET_MONTHLY_BUDGET>
LIVEKIT_COST_USD_PER_ROOM_MINUTE=<SET_CONTRACT_RATE>
LIVEKIT_MONTHLY_BUDGET_USD=<SET_MONTHLY_BUDGET>
OBJECT_STORAGE_BUDGET_GB=<SET_CAPACITY_BUDGET>

# ── Backup (S3/MinIO) ───────────────────────────────────────────────
BACKUP_S3_BUCKET=warptalk-backups
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_ACCESS_KEY=<GENERATE_SECURE_PASSWORD>
BACKUP_S3_SECRET_KEY=<GENERATE_SECURE_PASSWORD>

# Workspace document object storage
MINIO_ROOT_USER=<GENERATE_SECURE_USERNAME>
MINIO_ROOT_PASSWORD=<GENERATE_SECURE_PASSWORD>
MINIO_WORKSPACE_DOCUMENTS_BUCKET=warptalk-workspace-documents
MINIO_MEETING_CHAT_BUCKET=warptalk-meeting-chat
MINIO_VOICE_SAMPLES_BUCKET=warptalk-voice-samples
WORKSPACE_STORAGE_PROVIDER=MinIO
WORKSPACE_STORAGE_S3_ENDPOINT=http://minio:9000
WORKSPACE_STORAGE_MASTER_KEY=<GENERATE_SECURE_PASSWORD_MIN_32_CHARS>
WORKSPACE_STORAGE_ENSURE_BUCKET=false
MEETING_CHAT_STORAGE_PROVIDER=MinIO
MEETING_CHAT_STORAGE_S3_ENDPOINT=http://minio:9000
MEETING_CHAT_STORAGE_ENSURE_BUCKET=false
AUTH_STORAGE_PROVIDER=MinIO
AUTH_STORAGE_S3_ENDPOINT=http://minio:9000
AUTH_STORAGE_ENSURE_BUCKET=false

# ── Resend Email ─────────────────────────────────────────────────────
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=no-reply@warptalk.io.vn
RESEND_FROM_NAME=WarpTalk

# ── SMTP fallback and Assistant provider ─────────────────────────────
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USERNAME=<SMTP_USERNAME>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM_EMAIL=no-reply@warptalk.io.vn
SMTP_FROM_NAME=WarpTalk
OPENAI_API_KEY=<OPENAI_API_KEY>

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
