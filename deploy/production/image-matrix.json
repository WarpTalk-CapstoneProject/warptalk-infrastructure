{
  "schemaVersion": 1,
  "platform": "linux/amd64",
  "images": [
    { "name": "auth-service", "service": "auth-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "auth/Dockerfile", "sourcePaths": ["auth/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "workspace-service", "service": "workspace-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "workspace/Dockerfile", "sourcePaths": ["workspace/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "translation-room-service", "service": "translation-room-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "translation-room/Dockerfile", "sourcePaths": ["translation-room/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "transcript-service", "service": "transcript-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "transcript/Dockerfile", "sourcePaths": ["transcript/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "notification-service", "service": "notification-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "notification/Dockerfile", "sourcePaths": ["notification/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "meeting-service", "service": "meeting-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "meeting/Dockerfile", "sourcePaths": ["meeting/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "assistant-service", "service": "assistant-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "assistant/Dockerfile", "sourcePaths": ["assistant/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "billing-service", "service": "billing-service", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "billing/Dockerfile", "sourcePaths": ["billing/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "gateway", "service": "gateway", "role": "app", "triggersMigrations": true, "repository": "warptalk-backend", "context": "warptalk-backend", "dockerfile": "gateway/src/WarpTalk.Gateway/Dockerfile", "sourcePaths": ["gateway/", "shared/", "Directory.Build.props", ".dockerignore"] },
    { "name": "health-inspector", "service": "health-inspector", "role": "none", "repository": "warptalk-infrastructure", "context": "warptalk-infrastructure", "dockerfile": "health-inspector/Dockerfile", "compose": false, "k3s": false, "sourcePaths": ["health-inspector/"] },
    { "name": "migrator", "service": "migrator", "role": "none", "repository": "warptalk-infrastructure", "context": "warptalk-infrastructure", "dockerfile": "deploy/k3s/migrator.Dockerfile", "compose": false, "sourcePaths": ["scripts/"] },
    {
      "name": "frontend",
      "service": "frontend",
      "role": "app",
      "repository": "warptalk-web",
      "context": "warptalk-web",
      "dockerfile": "Dockerfile",
      "buildArgs": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_SIGNALR_URL",
        "NEXT_PUBLIC_LIVEKIT_URL",
        "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
      ]
    },
    { "name": "ai-stt", "service": "stt-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "stt", "sourcePaths": ["stt_worker/", "translation_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-translation", "service": "translation-worker", "alsoServices": ["translation-backfill-worker", "transcript-clean-worker"], "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "translation", "sourcePaths": ["translation_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-tts", "service": "tts-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "tts", "sourcePaths": ["tts_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-assistant", "service": "assistant-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "assistant", "sourcePaths": ["ai_assistant_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-suggestion", "service": "suggestion-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "suggestion", "sourcePaths": ["suggestion_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-embedding", "service": "embedding-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "embedding", "sourcePaths": ["embedding_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-billing", "service": "billing-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "billing", "sourcePaths": ["billing_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-livekit-ingress", "service": "livekit-ingress-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "livekit-ingress", "sourcePaths": ["livekit_ingress_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-security", "service": "security-worker", "role": "app", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "security", "sourcePaths": ["security_worker/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] },
    { "name": "ai-metrics", "service": "metrics-exporter", "role": "infra", "repository": "warptalk-ai", "context": "warptalk-ai", "dockerfile": "Dockerfile", "target": "metrics", "sourcePaths": ["metrics_exporter/", "shared/", "pyproject.toml", "uv.lock", ".dockerignore"] }
  ]
}
