# Copy to .env.production on each VM and replace every CHANGE_ME value.
# Keep the same shared values on both VMs. Never commit .env.production.

COMPOSE_PROJECT_NAME=warptalk
IMAGE_REGISTRY=ghcr.io/CHANGE_ME/warptalk
IMAGE_TAG=CHANGE_ME_RELEASE_SHA

# Private RFC1918 addresses assigned by the provider.
APP_PRIVATE_IP=10.20.0.200
DATA_PRIVATE_IP=10.20.0.20
INFRA_PRIVATE_IP=10.20.0.30

APP_DOMAIN=app.warptalk.io.vn
API_DOMAIN=api.warptalk.io.vn
ACME_EMAIL=CHANGE_ME

POSTGRES_DB=warptalk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
AUTH_DB_PASSWORD=CHANGE_ME
TRANSLATION_ROOM_DB_PASSWORD=CHANGE_ME
TRANSCRIPT_DB_PASSWORD=CHANGE_ME
MEETING_DB_PASSWORD=CHANGE_ME
ASSISTANT_DB_PASSWORD=CHANGE_ME
SUBSCRIPTION_DB_PASSWORD=CHANGE_ME
WORKSPACE_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_PASSWORD=CHANGE_ME
MONITOR_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
RABBITMQ_USERNAME=warptalk
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_WORKSPACE_DOCUMENTS_BUCKET=warptalk-workspace-documents
MINIO_MEETING_CHAT_BUCKET=warptalk-meeting-chat
MINIO_VOICE_SAMPLES_BUCKET=warptalk-voice-samples
WORKSPACE_STORAGE_MASTER_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS

JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS
# Semicolon-separated retired keys accepted only during a bounded rotation window.
JWT_PREVIOUS_SECRETS=
GRPC_INTERNAL_SECRET=CHANGE_ME_MINIMUM_64_CHARACTERS
JWT_ISSUER=WarpTalk.AuthService
JWT_AUDIENCE=WarpTalk
RATE_LIMIT_IP_PER_WINDOW=300
RATE_LIMIT_USER_PER_WINDOW=180
RATE_LIMIT_WORKSPACE_PER_WINDOW=1000
RATE_LIMIT_LOGIN_PER_WINDOW=5
RATE_LIMIT_INBOX_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=https://app.warptalk.io.vn

LIVEKIT_URL=wss://CHANGE_ME.livekit.cloud
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_EGRESS_S3_ACCESS_KEY=CHANGE_ME
LIVEKIT_EGRESS_S3_SECRET=CHANGE_ME
LIVEKIT_EGRESS_S3_BUCKET=warptalk-recordings
LIVEKIT_EGRESS_S3_REGION=ap-southeast-1
LIVEKIT_EGRESS_S3_ENDPOINT=https://CHANGE_ME

OPENAI_API_KEY=CHANGE_ME
OPENAI_CHAT_TRANSLATION_MODEL=gpt-4o-mini
GOOGLE_CLIENT_ID=CHANGE_ME
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=no-reply@warptalk.io.vn
SMTP_FROM_NAME=WarpTalk
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_EMAIL=no-reply@warptalk.io.vn
RESEND_FROM_NAME=WarpTalk

# Internal-only observability UIs are reached through an SSH/VPN tunnel.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Generate with: echo '<password>' | docker run --rm -i datalust/seq:2026.1.17004-x64 config hash
SEQ_ADMIN_PASSWORD_HASH=CHANGE_ME
ALERT_EMAIL_TO=CHANGE_ME
ALERTMANAGER_CONFIG_PATH=/etc/warptalk/alertmanager.yml

# Replace with rates from the signed provider contracts before rendering.
# These drive operational estimates/alerts only, never customer invoices.
# Every value below must be greater than zero. Zero is not a way to switch an
# alert off: a zero budget makes its alerts fire unconditionally and a zero rate
# makes them permanently silent, so the renderer rejects it.
AI_COST_STT_USD_PER_MINUTE=CHANGE_ME_NUMERIC
AI_COST_TRANSLATION_USD_PER_MINUTE=CHANGE_ME_NUMERIC
AI_COST_TTS_USD_PER_MINUTE=CHANGE_ME_NUMERIC
AI_COST_VOICE_CLONE_USD_PER_MINUTE=CHANGE_ME_NUMERIC
AI_BUDGET_STT_USD=CHANGE_ME_NUMERIC
AI_BUDGET_TRANSLATION_USD=CHANGE_ME_NUMERIC
AI_BUDGET_TTS_USD=CHANGE_ME_NUMERIC
AI_BUDGET_VOICE_CLONE_USD=CHANGE_ME_NUMERIC
LIVEKIT_COST_USD_PER_ROOM_MINUTE=CHANGE_ME_NUMERIC
LIVEKIT_MONTHLY_BUDGET_USD=CHANGE_ME_NUMERIC
OBJECT_STORAGE_BUDGET_GB=CHANGE_ME_NUMERIC

# Backup job values live in /etc/warptalk/backup.env on the Data VM. They are
# listed in backup.env.example and intentionally not passed to app containers.

# AI worker provider/config values are loaded explicitly from this file.
STT_PROVIDER=CHANGE_ME
TRANSLATION_PROVIDER=CHANGE_ME
TTS_PROVIDER=CHANGE_ME
STT_API_KEY=CHANGE_ME
TRANSLATION_API_KEY=CHANGE_ME
TTS_API_KEY=CHANGE_ME
