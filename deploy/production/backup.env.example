# Install as /etc/warptalk/backup.env with mode 0600 on the Data VM.
BACKUP_ROOT=/var/backups/warptalk
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=warptalk_backup
PGPASSWORD=CHANGE_ME
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=CHANGE_ME

# Store the matching age identity offline and in the protected recovery vault.
AGE_RECIPIENT=age1CHANGE_ME

# Cloudflare R2, AWS S3 or another compatible versioned offsite bucket.
BACKUP_S3_BUCKET=warptalk-production-backups
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=auto
