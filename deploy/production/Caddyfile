{
	email {$ACME_EMAIL}
	admin off
}

(security_headers) {
	header {
		# 'wasm-unsafe-eval' in script-src is load-bearing, not boilerplate.
		#
		# Chrome refuses WebAssembly.instantiate under a script-src that does not allow it, and
		# two shipped features are WASM: the Krisp noise filter and the MediaPipe background
		# blur. Without this token both fail at runtime — Krisp falls back to the browser's own
		# suppression, which is a loudness gate rather than a model, and users report exactly
		# that ("you have to shout before it picks you up"). Background blur simply never turns
		# on. WT-194 is the same missing token seen from the MediaPipe side.
		#
		# It is far narrower than 'unsafe-eval': it permits WebAssembly compilation and nothing
		# else — no eval(), no Function() from strings. Do not "simplify" it to 'unsafe-eval'.
		#
		# `blob:` in frame-src is load-bearing too, for the same reason and from the same family
		# of bug (WT-600, after WT-194 and the Krisp token above).
		#
		# Documents are previewed from the DOWNLOAD BYTES, in the browser, so nothing pending
		# approval is uploaded anywhere to be converted. A PDF is handed to the browser's own
		# viewer as `<iframe src={URL.createObjectURL(blob)}>`, and an iframe's src is governed by
		# frame-src. Without `blob:` Chrome blocked it and drew a broken-file icon — which is what
		# the report "cannot view an uploaded PDF" was, and only in production, because a dev
		# server sends no CSP at all.
		#
		# This does NOT loosen clickjacking protection: frame-src governs what THIS page may put
		# in a frame, not who may frame this page. That is frame-ancestors 'none' and
		# X-Frame-Options DENY, both unchanged above. A blob: URL is same-origin and minted by our
		# own code from bytes we just fetched.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; frame-src 'self' blob: https://accounts.google.com/gsi/; object-src 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss: https://accounts.google.com/gsi/; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style https://fonts.googleapis.com; font-src 'self' data: https:; worker-src 'self' blob:"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy frontend:3000
}

{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy gateway:5200
}
