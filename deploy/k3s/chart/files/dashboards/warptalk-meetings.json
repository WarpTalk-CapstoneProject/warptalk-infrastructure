    {
      "id": 14,
      "type": "bargauge",
      "title": "Stage success rate (1h)",
      "description": "ok / (ok + error + timeout + vendor_error) per attempt (warptalk_stage_messages_total). vendor_error is a failure the worker swallowed so the meeting kept going.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (increase(warptalk_stage_messages_total{stage=~\"stt|translation|tts\",outcome=\"ok\"}[1h])) / sum by (stage) (increase(warptalk_stage_messages_total{stage=~\"stt|translation|tts\",outcome!=\"dead_letter\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{stage}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
