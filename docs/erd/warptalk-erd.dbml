Ref: subscription.payments.subscription_id > subscription.subscriptions.id
Ref: subscription.payments.user_id > auth.users.id
Ref: subscription.invoices.payment_id > subscription.payments.id
Ref: subscription.invoices.user_id > auth.users.id
