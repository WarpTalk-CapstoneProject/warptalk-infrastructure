Ref: transcript.translation_contents.previous_translation_content_id > transcript.translation_contents.id
Ref: transcript.segment_translation_links.segment_id > transcript.transcript_segments.id
Ref: transcript.segment_translation_links.translation_content_id > transcript.translation_contents.id
Ref: transcript.audio_dubbings.translation_content_id > transcript.translation_contents.id
Ref: transcript.audio_dubbings.previous_audio_dubbing_id > transcript.audio_dubbings.id
Ref: transcript.glossaries.workspace_id > workspace.workspaces.id
Ref: transcript.glossary_terms.glossary_id > transcript.glossaries.id
Ref: transcript.global_glossary_audits.term_id > transcript.global_glossary_terms.id
Ref: transcript.global_glossary_audits.actor_user_id > auth.users.id

// ── Billing ──────────────────────────────────────────────────────────────────
Ref: subscription.subscriptions.plan_id > subscription.plans.id
