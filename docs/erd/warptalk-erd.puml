@startuml warptalk-erd
' WarpTalk — logical ERD
'
' SCOPE
'   Entity names only, by request. No columns.
'
' WHAT IS DRAWN
'   The system AS DESIGNED. An entity appears here if the code defines it — a mapped entity, a
'   repository, or a gRPC contract — whether or not production has exercised it yet.
'
'   This is deliberate, and it is a correction. An earlier pass drew only tables with rows in
'   production, which quietly deleted real parts of the design: every billing entity (nobody has
'   subscribed yet), the whole polls / questions / breakouts feature set, and the RBAC permission
'   tables. "Not used yet" is not "not needed", and an ERD that confuses the two describes the
'   demo data rather than the system.
'
' WHAT IS NOT DRAWN
'   1. Four tables scheduled for removal. They exist only in the retired legacy `warptalk`
'      baseline dump and were carried into the per-service databases by the extraction. No entity,
'      no repository, no proto, no raw SQL, no Python reference, zero rows:
'        notification_campaigns, email_delivery_logs, push_delivery_logs, voice_consents
'      (notification.notifications is NOT in this list — it is still being verified.)
'   2. Infrastructure bookkeeping: schema_migrations (three copies per database),
'      service_schema_migrations, logical_database_extract, outbox_messages, inbox_messages.
'   3. workspace_knowledge_glossaries — exists only in the retired legacy database and was never
'      created in warptalk_workspace.
'
' WHAT "LINKED" MEANS HERE
'   Production runs one physical database PER SERVICE (warptalk_auth, warptalk_workspace,
'   warptalk_translation_room, warptalk_meeting, warptalk_transcript, warptalk_billing,
'   warptalk_assistant, warptalk_notification). Relationships crossing a package are therefore
'   LOGICAL — the id is carried, the foreign key is not enforced by Postgres. They are drawn
'   because the reader needs the model, not the deployment.

hide circle
hide empty members
skinparam linetype ortho
skinparam packageStyle rectangle

package "Auth" #F7F8FA {
  entity users
  entity user_settings
  entity roles
  entity user_roles
  entity permissions
  entity role_permissions
  entity refresh_tokens
}

package "Voice" #F7F8FA {
  entity voice_profiles
  entity voice_samples
}

package "Workspace" #F7F8FA {
  entity workspaces
  entity workspace_members
  entity workspace_invitations
  entity workspace_verified_domains
  entity workspace_documents
  entity workspace_document_access_policies
  entity workspace_document_audits
  entity workspace_entitlement_snapshots
  entity workspace_admin_actions
}

package "Translation Room" #F7F8FA {
  entity translation_room_series
  entity translation_rooms
  entity translation_room_participants
  entity translation_room_invitations
  entity translation_room_sessions
  entity translation_room_artifacts
  entity translation_room_audio_routes
  entity translation_room_feedback
  entity supported_languages
}

' The RTC layer. These are NOT the meeting — the meeting is translation_rooms. This package holds
' the live LiveKit session: who is streaming, room lock, recording egress, host handover.
package "RTC session (schema: meeting)" #F7F8FA {
  entity meeting_rooms
  entity rtc_stream_participants
  entity rtc_session_revocations
  entity meeting_tracks
  entity meeting_chat_messages
  entity meeting_chat_translations
  entity meeting_chat_moderation_events
  entity meeting_chat_assistant_requests
  entity polls
  entity poll_options
  entity poll_votes
  entity questions
  entity question_votes
  entity breakout_sessions
  entity breakout_assignments
}

package "Transcript" #F7F8FA {
  entity transcripts
  entity transcript_segments
  entity transcript_corrections
  entity transcript_exports
  entity translation_contents
  entity segment_translation_links
  entity audio_dubbings
  entity glossaries
  entity glossary_terms
  entity global_glossary_terms
  entity global_glossary_audits
}

package "Billing" #F7F8FA {
  entity plans
  entity subscriptions
  entity invoices
  entity payments
  entity refunds
  entity credit_transactions
  entity credit_balance_snapshots
  entity usage_records
  entity sales_inquiries
  entity billing_pricing_config
  entity usage_rate_card
  entity billing_policy_config
  entity workspace_entitlement_overrides
}

package "Assistant" #F7F8FA {
  entity assistant_conversations
  entity assistant_messages
  entity assistant_tool_calls
}

package "Notification" #F7F8FA {
  entity notification_messages
  entity notification_preferences
  entity notification_templates
  entity push_subscriptions
  entity admin_notifications
}

' ── Auth ─────────────────────────────────────────────────────────────────────
users ||--o{ user_settings
users ||--o{ refresh_tokens
users ||--o{ user_roles
roles ||--o{ user_roles
users }o--o{ roles : "granted (via user_roles)"

roles ||--o{ role_permissions
permissions ||--o{ role_permissions
roles }o--o{ permissions : "allows (via role_permissions)"

users ||--o{ voice_profiles
voice_profiles ||--o{ voice_samples

' ── Workspace ────────────────────────────────────────────────────────────────
workspaces ||--o{ workspace_members
users ||--o{ workspace_members
users }o--o{ workspaces : "belongs to (via workspace_members)"

workspaces ||--o{ workspace_invitations
workspaces ||--o{ workspace_verified_domains
workspaces ||--o{ workspace_entitlement_snapshots
workspaces ||--o{ workspace_admin_actions
workspaces ||--o{ workspace_documents
workspace_documents ||--o{ workspace_document_access_policies
workspace_documents ||--o{ workspace_document_audits

' ── Translation Room ─────────────────────────────────────────────────────────
' A series is a BOOKING, not a meeting: it materialises one ordinary room per occurrence, and
' every occurrence answers to the same room code.
translation_room_series ||--o{ translation_rooms : "materialises"
workspaces ||--o{ translation_rooms
users ||--o{ translation_rooms : "hosts"

translation_rooms ||--o{ translation_room_participants
users ||--o{ translation_room_participants
users }o--o{ translation_rooms : "attends (via translation_room_participants)"

translation_rooms ||--o{ translation_room_invitations
translation_rooms ||--o{ translation_room_sessions
translation_rooms ||--o{ translation_room_artifacts
translation_rooms ||--o{ translation_room_audio_routes
translation_rooms ||--o{ translation_room_feedback
users ||--o{ translation_room_feedback
supported_languages ||--o{ translation_rooms : "source / target"

' ── RTC session ──────────────────────────────────────────────────────────────
' One meeting gets one live session when somebody starts it.
translation_rooms ||--o| meeting_rooms : "live session of"
meeting_rooms ||--o{ rtc_stream_participants
users ||--o{ rtc_stream_participants
rtc_stream_participants ||--o{ meeting_tracks
meeting_rooms ||--o{ rtc_session_revocations : "denies rejoin"

meeting_rooms ||--o{ meeting_chat_messages
meeting_chat_messages ||--o{ meeting_chat_translations
meeting_chat_messages ||--o{ meeting_chat_moderation_events
meeting_chat_messages ||--o{ meeting_chat_assistant_requests

meeting_rooms ||--o{ polls
polls ||--o{ poll_options
poll_options ||--o{ poll_votes
users ||--o{ poll_votes
users }o--o{ poll_options : "votes for (via poll_votes)"

meeting_rooms ||--o{ questions
questions ||--o{ question_votes
users ||--o{ question_votes
users }o--o{ questions : "upvotes (via question_votes)"

meeting_rooms ||--o{ breakout_sessions
breakout_sessions ||--o{ breakout_assignments
users ||--o{ breakout_assignments
users }o--o{ breakout_sessions : "assigned to (via breakout_assignments)"

' ── Transcript ───────────────────────────────────────────────────────────────
translation_rooms ||--o{ transcripts
transcripts ||--o{ transcript_segments
' A correction belongs to a SEGMENT, not to the transcript, and there is no chain of
' corrections: each row is append-only and carries both OriginalText and CorrectedText, so a
' segment's history is its correction rows in order. An earlier draft drew a self-reference
' for versioning; the code has none.
transcript_segments ||--o{ transcript_corrections
users ||--o{ transcript_corrections : "submits"
translation_contents ||--o| transcript_corrections : "retranslation triggered by"
transcripts ||--o{ transcript_exports

transcript_segments ||--o{ segment_translation_links
translation_contents ||--o{ segment_translation_links
transcript_segments }o--o{ translation_contents : "translated as (via segment_translation_links)"

' One translated passage produces many dubbed files: different voices, and regenerated versions
' over time. The chain carries that history — there is no link to a voice profile.
translation_contents ||--o{ audio_dubbings
audio_dubbings ||--o| audio_dubbings : "regenerated from"

workspaces ||--o{ glossaries
glossaries ||--o{ glossary_terms
global_glossary_terms ||--o{ global_glossary_audits

' ── Billing ──────────────────────────────────────────────────────────────────
plans ||--o{ subscriptions
workspaces ||--o{ subscriptions
subscriptions ||--o{ invoices
invoices ||--o{ payments
payments ||--o{ refunds
workspaces ||--o{ credit_transactions
workspaces ||--o{ credit_balance_snapshots
workspaces ||--o{ usage_records
workspaces ||--o{ workspace_entitlement_overrides
usage_rate_card ||--o{ usage_records : "priced by"

' ── Assistant ────────────────────────────────────────────────────────────────
workspaces ||--o{ assistant_conversations
users ||--o{ assistant_conversations
assistant_conversations ||--o{ assistant_messages
assistant_messages ||--o{ assistant_tool_calls

' ── Notification ─────────────────────────────────────────────────────────────
users ||--o{ notification_preferences
users ||--o{ notification_messages
notification_templates ||--o{ notification_messages : "rendered from"
users ||--o{ push_subscriptions

@enduml
