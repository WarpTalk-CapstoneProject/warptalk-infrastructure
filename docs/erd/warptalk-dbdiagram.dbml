// =============================================================================
// WarpTalk — DBML for dbdiagram.io
//
// SOURCE OF TRUTH
//   Tables and relationships: docs/erd/WarpTalk-ERD-Entities.puml
//   Detailed Relationships:   docs/erd/WarpTalk-ERD-Relationships-Detail.md
//   Migrations & Schemas:     warptalk-infrastructure/scripts/migrations/*.sql
//
// CO-LOCATED TABLEGROUP & INTRA-GROUP REFS LAYOUT
//   Tables and internal relationships are co-located per TableGroup for compact rendering.
//   Logical cross-database references are defined in the cross-package section at the bottom.
// =============================================================================

Project WarpTalk {
  database_type: 'PostgreSQL'
  Note: 'AI Speech Translation Platform for Real-Time Multilingual Communication with Voice Cloning. Eight logical databases, one per service.'
}

// ═══════════════════════════════════════════════════════════════════════════
// 1. AUTH SERVICE (`auth` & `voice`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Auth {
  auth.users
  auth.user_settings
  auth.roles
  auth.permissions
  auth.user_roles
  auth.role_permissions
  auth.refresh_tokens
  voice.voice_profiles
  voice.voice_consents
  voice.voice_samples
}

Table auth.users {
  id uuid [pk]
  email varchar(320) [not null, unique]
  password_hash varchar(255)
  full_name varchar(150) [not null]
  avatar_url varchar(500)
  phone varchar(20)
  preferred_language varchar(15) [not null, default: 'vi-VN']
  timezone varchar(50) [not null, default: 'Asia/Ho_Chi_Minh']
  is_active boolean [not null, default: true]
  is_locked boolean [not null, default: false]
  failed_login_attempts integer [not null, default: 0]
  locked_until timestamptz
  email_verified boolean [not null, default: false]
  email_verified_at timestamptz
  google_id varchar(255) [unique]
  last_login_at timestamptz
  last_login_ip varchar(45)
  email_verification_token_hash varchar(64)
  email_verification_token_expires_at timestamptz
  password_reset_token_hash varchar(64)
  password_reset_token_expires_at timestamptz
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table auth.user_settings {
  id uuid [pk]
  user_id uuid [not null, unique]
  default_speak_language varchar(15) [not null, default: 'vi-VN']
  default_listen_language varchar(15) [not null, default: 'en-US']
  voice_clone_enabled boolean [not null, default: false]
  mic_noise_suppression boolean [not null, default: true]
  default_translation_room_type varchar(20) [not null, default: 'group']
  auto_record_translation_rooms boolean [not null, default: false]
  auto_generate_summary boolean [not null, default: true]
  default_max_participants integer [not null, default: 10]
  theme varchar(10) [not null, default: 'system']
  transcript_font_size integer [not null, default: 14]
  show_original_transcript boolean [not null, default: true]
  show_translated_transcript boolean [not null, default: true]
  high_contrast boolean [not null, default: false]
  screen_reader_mode boolean [not null, default: false]
  updated_at timestamptz [not null]
  updated_by uuid
}

Table auth.roles {
  id uuid [pk]
  name varchar(50) [not null, unique]
  description varchar(255)
  is_system boolean [not null, default: false]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table auth.permissions {
  id uuid [pk]
  code varchar(100) [not null, unique]
  module varchar(50) [not null]
  description varchar(255)
  created_at timestamptz [not null]
}

Table auth.user_roles {
  user_id uuid [not null]
  role_id uuid [not null]
  assigned_at timestamptz [not null]
  assigned_by uuid

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table auth.role_permissions {
  role_id uuid [not null]
  permission_id uuid [not null]
  granted_at timestamptz [not null]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table auth.refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  family_id uuid
  is_revoked boolean [not null, default: false]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  created_by_ip varchar(45)
  revoked_at timestamptz
  revoked_by_ip varchar(45)
  replaced_by_token_id uuid
}

Table voice.voice_profiles {
  id uuid [pk]
  user_id uuid [not null]
  workspace_id uuid
  voice_name varchar(100) [not null]
  description text
  provider varchar(50) [not null, default: 'cartesia']
  provider_voice_id varchar(255) [not null]
  language varchar(15) [not null, default: 'vi-VN']
  status varchar(20) [not null, default: 'active']
  sample_count integer [not null, default: 0]
  total_duration_seconds numeric(10,2) [not null, default: 0]
  is_default boolean [not null, default: false]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table voice.voice_consents {
  id uuid [pk]
  voice_profile_id uuid [not null]
  user_id uuid [not null]
  consent_statement text [not null]
  recording_url varchar(500)
  accepted_at timestamptz [not null]
  ip_address varchar(45)
  created_at timestamptz [not null]
}

Table voice.voice_samples {
  id uuid [pk]
  voice_profile_id uuid [not null]
  file_name varchar(255) [not null]
  file_path varchar(500) [not null]
  file_size_bytes bigint [not null]
  duration_seconds numeric(10,2) [not null]
  format varchar(20) [not null]
  sample_rate integer
  status varchar(20) [not null, default: 'ready']
  created_at timestamptz [not null]
  created_by uuid
}

// Auth Intra-Group FKs
Ref: auth.user_settings.user_id - auth.users.id
Ref: auth.user_roles.user_id > auth.users.id
Ref: auth.user_roles.role_id > auth.roles.id
Ref: auth.role_permissions.role_id > auth.roles.id
Ref: auth.role_permissions.permission_id > auth.permissions.id
Ref: auth.refresh_tokens.user_id > auth.users.id
Ref: voice.voice_consents.voice_profile_id > voice.voice_profiles.id
Ref: voice.voice_samples.voice_profile_id > voice.voice_profiles.id

// ═══════════════════════════════════════════════════════════════════════════
// 2. WORKSPACE SERVICE (`workspace`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Workspace {
  workspace.workspaces
  workspace.workspace_members
  workspace.workspace_invitations
  workspace.workspace_verified_domains
  workspace.workspace_documents
  workspace.workspace_document_access_policies
  workspace.workspace_document_audits
  workspace.workspace_entitlement_snapshots
  workspace.workspace_admin_actions
  workspace.outbox_messages
}

Table workspace.workspaces {
  id uuid [pk]
  name varchar(100) [not null]
  slug varchar(100) [not null, unique]
  owner_id uuid [not null]
  logo_url varchar(500)
  description varchar(500)
  max_members integer [not null, default: 50]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table workspace.workspace_members {
  id uuid [pk]
  workspace_id uuid [not null]
  user_id uuid [not null]
  role_id uuid [not null]
  can_create_meetings boolean [not null, default: true]
  status varchar(20) [not null, default: 'active']
  joined_at timestamptz [not null]
  invited_by uuid

  Indexes {
    (workspace_id, user_id) [unique]
  }
}

Table workspace.workspace_invitations {
  id uuid [pk]
  workspace_id uuid [not null]
  email varchar(320) [not null]
  role_id uuid [not null]
  token_hash varchar(255) [not null, unique]
  status varchar(20) [not null, default: 'pending']
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  created_by uuid
  delivered_at timestamptz
  delivery_attempts integer [not null, default: 0]
  last_delivery_error text
}

Table workspace.workspace_verified_domains {
  id uuid [pk]
  workspace_id uuid [not null]
  domain varchar(255) [not null]
  verification_token varchar(100) [not null]
  is_verified boolean [not null, default: false]
  verified_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    (workspace_id, domain) [unique]
  }
}

Table workspace.workspace_documents {
  id uuid [pk]
  workspace_id uuid [not null]
  title varchar(255) [not null]
  file_path varchar(500) [not null]
  file_type varchar(50) [not null]
  file_size_bytes bigint [not null]
  is_ai_allowed boolean [not null, default: true]
  status varchar(20) [not null, default: 'ready']
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table workspace.workspace_document_access_policies {
  id uuid [pk]
  workspace_id uuid [not null]
  document_id uuid [not null]
  subject_type varchar(20) [not null]
  subject_key varchar(100) [not null]
  can_read boolean [not null, default: true]
  can_write boolean [not null, default: false]
  created_at timestamptz [not null]
}

Table workspace.workspace_document_audits {
  id uuid [pk]
  workspace_id uuid [not null]
  document_id uuid [not null]
  actor_user_id uuid [not null]
  action varchar(50) [not null]
  details jsonb
  created_at timestamptz [not null]
}

Table workspace.workspace_entitlement_snapshots {
  workspace_id uuid [pk]
  plan_key varchar(50) [not null]
  max_members integer [not null]
  ai_features_enabled boolean [not null, default: true]
  voice_cloning_enabled boolean [not null, default: false]
  updated_at timestamptz [not null]
}

Table workspace.workspace_admin_actions {
  id uuid [pk]
  workspace_id uuid [not null]
  admin_user_id uuid [not null]
  action_type varchar(50) [not null]
  target_user_id uuid
  reason text
  created_at timestamptz [not null]
}

Table workspace.outbox_messages {
  id uuid [pk]
  event_type varchar(150) [not null]
  compatibility_event_type varchar(100) [not null]
  schema_version integer [not null, default: 1]
  occurred_at timestamptz [not null]
  producer varchar(100) [not null]
  correlation_id varchar(100)
  causation_id varchar(100)
  workspace_id uuid
  payload_json jsonb [not null]
  attempt_count integer [not null, default: 0]
  available_at timestamptz [not null]
  published_at timestamptz
  locked_at timestamptz
  dead_lettered_at timestamptz
  last_error text
  created_at timestamptz [not null, default: `now()`]
}

// Workspace Intra-Group FKs
Ref: workspace.workspace_members.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_invitations.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_verified_domains.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_documents.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_document_access_policies.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_document_access_policies.document_id > workspace.workspace_documents.id
Ref: workspace.workspace_document_audits.workspace_id > workspace.workspaces.id
Ref: workspace.workspace_document_audits.document_id > workspace.workspace_documents.id
Ref: workspace.workspace_admin_actions.workspace_id > workspace.workspaces.id

// ═══════════════════════════════════════════════════════════════════════════
// 3. TRANSLATION ROOM SERVICE (`translation_room`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup TranslationRoom {
  translation_room.translation_room_series
  translation_room.translation_rooms
  translation_room.translation_room_participants
  translation_room.translation_room_invitations
  translation_room.translation_room_sessions
  translation_room.translation_room_artifacts
  translation_room.translation_room_audio_routes
  translation_room.translation_room_feedback
  translation_room.supported_languages
}

Table translation_room.translation_room_series {
  id uuid [pk]
  workspace_id uuid [not null]
  title varchar(200) [not null]
  description text
  room_code varchar(20) [not null, unique]
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table translation_room.translation_rooms {
  id uuid [pk]
  workspace_id uuid [not null]
  host_id uuid [not null]
  active_host_id uuid
  series_id uuid
  title varchar(200) [not null]
  room_code varchar(20) [not null, unique]
  status varchar(20) [not null, default: 'created']
  source_language varchar(15) [not null, default: 'vi-VN']
  target_languages varchar(255) [not null, default: 'en-US']
  max_participants integer [not null, default: 10]
  is_locked boolean [not null, default: false]
  recording_enabled boolean [not null, default: false]
  scheduled_start_at timestamptz
  started_at timestamptz
  ended_at timestamptz
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
  deleted_at timestamptz
  deleted_by uuid
}

Table translation_room.translation_room_participants {
  id uuid [pk]
  translation_room_id uuid [not null]
  user_id uuid
  display_name varchar(150) [not null]
  speak_language varchar(15) [not null, default: 'vi-VN']
  listen_language varchar(15) [not null, default: 'en-US']
  role varchar(20) [not null, default: 'participant']
  is_audio_enabled boolean [not null, default: true]
  is_translation_audio_enabled boolean [not null, default: true]
  status varchar(20) [not null, default: 'joined']
  joined_at timestamptz [not null]
  left_at timestamptz

  Indexes {
    (translation_room_id, user_id)
  }
}

Table translation_room.translation_room_invitations {
  id uuid [pk]
  translation_room_id uuid [not null]
  email varchar(320) [not null]
  invite_code varchar(50) [not null, unique]
  status varchar(20) [not null, default: 'pending']
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  created_by uuid
}

Table translation_room.translation_room_sessions {
  id uuid [pk]
  translation_room_id uuid [not null]
  session_token varchar(255) [not null, unique]
  started_at timestamptz [not null]
  ended_at timestamptz
  created_at timestamptz [not null]
}

Table translation_room.translation_room_artifacts {
  id uuid [pk]
  translation_room_id uuid [not null]
  artifact_type varchar(50) [not null]
  title varchar(255) [not null]
  content text
  file_path varchar(500)
  file_size_bytes bigint
  created_at timestamptz [not null]
  created_by uuid
}

Table translation_room.translation_room_audio_routes {
  id uuid [pk]
  translation_room_id uuid [not null]
  source_participant_id uuid [not null]
  target_participant_id uuid [not null]
  source_language varchar(15) [not null]
  target_language varchar(15) [not null]
  status varchar(20) [not null, default: 'active']
  created_at timestamptz [not null]
}

Table translation_room.translation_room_feedback {
  id uuid [pk]
  translation_room_id uuid [not null]
  user_id uuid [not null]
  rating integer [not null]
  comments text
  audio_quality_rating integer
  translation_accuracy_rating integer
  created_at timestamptz [not null]
}

Table translation_room.supported_languages {
  code varchar(15) [pk]
  name varchar(100) [not null]
  native_name varchar(100) [not null]
  is_stt_supported boolean [not null, default: true]
  is_tts_supported boolean [not null, default: true]
  is_translation_supported boolean [not null, default: true]
  is_active boolean [not null, default: true]
}

// TranslationRoom Intra-Group FKs
Ref: translation_room.translation_rooms.series_id > translation_room.translation_room_series.id
Ref: translation_room.translation_room_participants.translation_room_id > translation_room.translation_rooms.id
Ref: translation_room.translation_room_invitations.translation_room_id > translation_room.translation_rooms.id
Ref: translation_room.translation_room_sessions.translation_room_id > translation_room.translation_rooms.id
Ref: translation_room.translation_room_artifacts.translation_room_id > translation_room.translation_rooms.id
Ref: translation_room.translation_room_audio_routes.translation_room_id > translation_room.translation_rooms.id
Ref: translation_room.translation_room_audio_routes.source_participant_id > translation_room.translation_room_participants.id
Ref: translation_room.translation_room_audio_routes.target_participant_id > translation_room.translation_room_participants.id
Ref: translation_room.translation_room_feedback.translation_room_id > translation_room.translation_rooms.id

// ═══════════════════════════════════════════════════════════════════════════
// 4. MEETING SERVICE (`meeting`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Meeting {
  meeting.meeting_rooms
  meeting.rtc_stream_participants
  meeting.meeting_tracks
  meeting.meeting_invitations
  meeting.rtc_session_revocations
  meeting.meeting_chat_messages
  meeting.meeting_chat_translations
  meeting.meeting_chat_assistant_requests
  meeting.meeting_chat_moderation_events
  meeting.polls
  meeting.poll_options
  meeting.poll_votes
  meeting.questions
  meeting.question_votes
  meeting.breakout_sessions
  meeting.breakout_assignments
}

Table meeting.meeting_rooms {
  id uuid [pk]
  translation_room_id uuid [not null]
  provider varchar(50) [not null, default: 'livekit']
  provider_room_name varchar(255) [not null]
  active_host_id uuid
  is_current boolean [not null, default: true]
  is_locked boolean [not null, default: false]
  recording_status varchar(20) [not null, default: 'none']
  recording_started_at timestamptz
  created_at timestamptz [not null]
  created_by uuid
  ended_at timestamptz
}

Table meeting.rtc_stream_participants {
  id uuid [pk]
  meeting_room_id uuid [not null]
  user_id uuid
  display_name varchar(150) [not null]
  connection_id varchar(255) [not null]
  joined_at timestamptz [not null]
  left_at timestamptz
  is_publisher boolean [not null, default: false]
}

Table meeting.meeting_tracks {
  id uuid [pk]
  participant_id uuid [not null]
  track_sid varchar(255) [not null]
  track_kind varchar(20) [not null]
  track_source varchar(20) [not null]
  is_muted boolean [not null, default: false]
  created_at timestamptz [not null]
}

Table meeting.meeting_invitations {
  id uuid [pk]
  meeting_room_id uuid [not null]
  invitee_email varchar(320) [not null]
  invite_code varchar(50) [not null, unique]
  status varchar(20) [not null, default: 'pending']
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table meeting.rtc_session_revocations {
  id uuid [pk]
  user_id uuid [not null]
  revoked_at timestamptz [not null]
  reason text
}

Table meeting.meeting_chat_messages {
  id uuid [pk]
  meeting_room_id uuid [not null]
  sender_user_id uuid [not null]
  sender_display_name varchar(150) [not null]
  message_text text [not null]
  source_language varchar(15) [not null, default: 'vi-VN']
  is_announcement boolean [not null, default: false]
  file_name varchar(255)
  file_url varchar(500)
  file_size_bytes bigint
  created_at timestamptz [not null]
}

Table meeting.meeting_chat_translations {
  id uuid [pk]
  message_id uuid [not null]
  target_language varchar(15) [not null]
  translated_text text [not null]
  created_at timestamptz [not null]

  Indexes {
    (message_id, target_language) [unique]
  }
}

Table meeting.meeting_chat_assistant_requests {
  id uuid [pk]
  message_id uuid [not null]
  prompt_text text [not null]
  response_text text
  status varchar(20) [not null, default: 'pending']
  created_at timestamptz [not null]
  completed_at timestamptz
}

Table meeting.meeting_chat_moderation_events {
  id uuid [pk]
  message_id uuid [not null]
  moderator_user_id uuid [not null]
  action varchar(50) [not null]
  reason text
  created_at timestamptz [not null]
}

Table meeting.polls {
  id uuid [pk]
  meeting_room_id uuid [not null]
  created_by uuid [not null]
  question text [not null]
  is_multiple_choice boolean [not null, default: false]
  status varchar(20) [not null, default: 'open']
  created_at timestamptz [default: `now()`]
  closed_at timestamptz
}

Table meeting.poll_options {
  id uuid [pk]
  poll_id uuid [not null]
  label text [not null]
  position integer [not null]
}

Table meeting.poll_votes {
  id uuid [pk]
  poll_id uuid [not null]
  option_id uuid [not null]
  user_id uuid [not null]
  created_at timestamptz [default: `now()`]

  Indexes {
    (poll_id, option_id, user_id) [unique]
  }
}

Table meeting.questions {
  id uuid [pk]
  meeting_room_id uuid [not null]
  asked_by uuid [not null]
  asked_by_display_name text [not null]
  body text [not null]
  status varchar(20) [not null, default: 'open']
  created_at timestamptz [default: `now()`]
  answered_at timestamptz
}

Table meeting.question_votes {
  id uuid [pk]
  question_id uuid [not null]
  user_id uuid [not null]

  Indexes {
    (question_id, user_id) [unique]
  }
}

Table meeting.breakout_sessions {
  id uuid [pk]
  parent_meeting_room_id uuid [not null]
  provider_room_name text [not null]
  label text [not null]
  duration_seconds integer
  started_at timestamptz
  ended_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table meeting.breakout_assignments {
  id uuid [pk]
  breakout_session_id uuid [not null]
  user_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
}

// Meeting Intra-Group FKs
Ref: meeting.rtc_stream_participants.meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.meeting_tracks.participant_id > meeting.rtc_stream_participants.id
Ref: meeting.meeting_invitations.meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.meeting_chat_messages.meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.meeting_chat_translations.message_id > meeting.meeting_chat_messages.id
Ref: meeting.meeting_chat_assistant_requests.message_id > meeting.meeting_chat_messages.id
Ref: meeting.meeting_chat_moderation_events.message_id > meeting.meeting_chat_messages.id
Ref: meeting.polls.meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.poll_options.poll_id > meeting.polls.id
Ref: meeting.poll_votes.poll_id > meeting.polls.id
Ref: meeting.poll_votes.option_id > meeting.poll_options.id
Ref: meeting.questions.meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.question_votes.question_id > meeting.questions.id
Ref: meeting.breakout_sessions.parent_meeting_room_id > meeting.meeting_rooms.id
Ref: meeting.breakout_assignments.breakout_session_id > meeting.breakout_sessions.id

// ═══════════════════════════════════════════════════════════════════════════
// 5. TRANSCRIPT SERVICE (`transcript`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Transcript {
  transcript.transcripts
  transcript.transcript_segments
  transcript.transcript_corrections
  transcript.transcript_exports
  transcript.translation_contents
  transcript.segment_translation_links
  transcript.audio_dubbings
  transcript.glossaries
  transcript.glossary_terms
  transcript.global_glossary_terms
  transcript.global_glossary_audits
}

Table transcript.transcripts {
  id uuid [pk]
  translation_room_id uuid [not null]
  translation_room_session_id uuid
  workspace_id uuid [not null]
  title varchar(255) [not null]
  language varchar(15) [not null, default: 'vi-VN']
  status varchar(20) [not null, default: 'active']
  total_segments integer [not null, default: 0]
  total_words integer [not null, default: 0]
  duration_seconds numeric(10,2) [not null, default: 0]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
}

Table transcript.transcript_segments {
  id uuid [pk]
  transcript_id uuid [not null]
  speaker_participant_id uuid [not null]
  speaker_name varchar(150) [not null]
  start_time_seconds numeric(10,3) [not null]
  end_time_seconds numeric(10,3) [not null]
  text text [not null]
  language varchar(15) [not null]
  confidence numeric(5,4)
  is_final boolean [not null, default: true]
  created_at timestamptz [not null]
}

Table transcript.transcript_corrections {
  id uuid [pk]
  segment_id uuid [not null]
  corrected_by_user_id uuid [not null]
  original_text text [not null]
  corrected_text text [not null]
  reason text
  created_at timestamptz [not null]
}

Table transcript.transcript_exports {
  id uuid [pk]
  transcript_id uuid [not null]
  export_format varchar(20) [not null]
  file_path varchar(500) [not null]
  file_size_bytes bigint [not null]
  created_at timestamptz [not null]
  created_by uuid
}

Table transcript.translation_contents {
  id uuid [pk]
  workspace_id uuid [not null]
  target_language varchar(15) [not null]
  translated_text text [not null]
  created_at timestamptz [not null]
}

Table transcript.segment_translation_links {
  segment_id uuid [not null]
  translation_content_id uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (segment_id, translation_content_id) [pk]
  }
}

Table transcript.audio_dubbings {
  id uuid [pk]
  translation_content_id uuid [not null]
  voice_profile_id uuid
  audio_url varchar(500) [not null]
  duration_seconds numeric(10,3) [not null]
  format varchar(20) [not null, default: 'mp3']
  status varchar(20) [not null, default: 'ready']
  created_at timestamptz [not null]
}

Table transcript.glossaries {
  id uuid [pk]
  workspace_id uuid [not null]
  name varchar(100) [not null]
  description text
  source_language varchar(15) [not null, default: 'vi-VN']
  target_language varchar(15) [not null, default: 'en-US']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
}

Table transcript.glossary_terms {
  id uuid [pk]
  glossary_id uuid [not null]
  source_term varchar(255) [not null]
  target_term varchar(255) [not null]
  notes text
  created_at timestamptz [not null]
  created_by uuid
}

Table transcript.global_glossary_terms {
  id uuid [pk]
  source_term text [not null]
  target_term text [not null]
  source_language varchar(15) [not null]
  target_language varchar(15) [not null]
  category varchar(100) [not null]
  created_at timestamptz [not null]
}

Table transcript.global_glossary_audits {
  id uuid [pk]
  term_id uuid [not null]
  action varchar(50) [not null]
  performed_by uuid [not null]
  created_at timestamptz [not null]
}

// Transcript Intra-Group FKs
Ref: transcript.transcript_segments.transcript_id > transcript.transcripts.id
Ref: transcript.transcript_corrections.segment_id > transcript.transcript_segments.id
Ref: transcript.transcript_exports.transcript_id > transcript.transcripts.id
Ref: transcript.segment_translation_links.segment_id > transcript.transcript_segments.id
Ref: transcript.segment_translation_links.translation_content_id > transcript.translation_contents.id
Ref: transcript.audio_dubbings.translation_content_id > transcript.translation_contents.id
Ref: transcript.glossary_terms.glossary_id > transcript.glossaries.id

// ═══════════════════════════════════════════════════════════════════════════
// 6. SUBSCRIPTION / BILLING SERVICE (`subscription`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Subscription {
  subscription.plans
  subscription.subscriptions
  subscription.payments
  subscription.refunds
  subscription.invoices
  subscription.credit_transactions
  subscription.credit_balance_snapshots
  subscription.usage_records
  subscription.usage_rate_card
  subscription.workspace_entitlement_overrides
  subscription.billing_pricing_config
  subscription.billing_policy_config
  subscription.idempotency_records
  subscription.sales_inquiries
  subscription.outbox_messages
  subscription.inbox_messages
}

Table subscription.plans {
  id uuid [pk]
  name varchar(100) [not null, unique]
  code varchar(50) [not null, unique]
  description text
  monthly_price_usd numeric(10,2) [not null]
  yearly_price_usd numeric(10,2) [not null]
  included_credits numeric(12,2) [not null, default: 0]
  max_members integer [not null, default: 10]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
}

Table subscription.subscriptions {
  id uuid [pk]
  workspace_id uuid [not null]
  plan_id uuid [not null]
  user_id uuid [not null]
  status varchar(20) [not null, default: 'active']
  billing_cycle varchar(20) [not null, default: 'monthly']
  current_period_start timestamptz [not null]
  current_period_end timestamptz [not null]
  cancel_at_period_end boolean [not null, default: false]
  created_at timestamptz [not null]
  created_by uuid
  updated_at timestamptz
  updated_by uuid
}

Table subscription.payments {
  id uuid [pk]
  subscription_id uuid [not null]
  amount_usd numeric(10,2) [not null]
  payment_provider varchar(50) [not null, default: 'stripe']
  provider_transaction_id varchar(255)
  status varchar(20) [not null, default: 'completed']
  paid_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table subscription.refunds {
  id uuid [pk]
  payment_id uuid [not null]
  amount_usd numeric(10,2) [not null]
  reason text
  status varchar(20) [not null, default: 'completed']
  created_at timestamptz [not null]
}

Table subscription.invoices {
  id uuid [pk]
  subscription_id uuid [not null]
  payment_id uuid
  invoice_number varchar(100) [not null, unique]
  amount_usd numeric(10,2) [not null]
  pdf_url varchar(500)
  status varchar(20) [not null, default: 'paid']
  issued_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table subscription.credit_transactions {
  id uuid [pk]
  subscription_id uuid [not null]
  transaction_type varchar(50) [not null]
  amount_credits numeric(12,2) [not null]
  balance_after numeric(12,2) [not null]
  description text
  created_at timestamptz [not null]
}

Table subscription.credit_balance_snapshots {
  id uuid [pk]
  subscription_id uuid [not null]
  snapshot_date date [not null]
  credit_balance numeric(12,2) [not null]
  created_at timestamptz [not null]
}

Table subscription.usage_records {
  id uuid [pk]
  subscription_id uuid [not null]
  service_type varchar(50) [not null]
  units_consumed numeric(12,4) [not null]
  credits_deducted numeric(12,2) [not null]
  segment_id uuid
  created_at timestamptz [not null]
}

Table subscription.usage_rate_card {
  id uuid [pk]
  service_type varchar(50) [not null, unique]
  unit_name varchar(50) [not null]
  credits_per_unit numeric(10,4) [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
}

Table subscription.workspace_entitlement_overrides {
  id uuid [pk]
  workspace_id uuid [not null]
  feature_key varchar(100) [not null]
  is_enabled boolean [not null]
  override_value jsonb
  created_at timestamptz [not null]
}

Table subscription.billing_pricing_config {
  key varchar(80) [pk]
  value numeric(18,6) [not null]
  updated_at timestamptz [not null, default: `NOW()`]
}

Table subscription.billing_policy_config {
  key varchar(100) [pk]
  value numeric(18,6) [not null]
  updated_at timestamptz [not null, default: `NOW()`]
}

Table subscription.idempotency_records {
  idempotency_key varchar(255) [pk]
  response_payload jsonb [not null]
  created_at timestamptz [not null]
}

Table subscription.sales_inquiries {
  id uuid [pk]
  full_name varchar(150) [not null]
  email varchar(320) [not null]
  company_name varchar(200) [not null]
  company_size varchar(50)
  message text
  status varchar(20) [not null, default: 'pending']
  created_at timestamptz [not null]
}

Table subscription.outbox_messages {
  id uuid [pk]
  event_type varchar(150) [not null]
  payload_json jsonb [not null]
  created_at timestamptz [not null]
  published_at timestamptz
}

Table subscription.inbox_messages {
  id uuid [pk]
  event_id uuid [not null, unique]
  event_type varchar(150) [not null]
  payload_json jsonb [not null]
  processed_at timestamptz [not null]
}

// Subscription Intra-Group FKs
Ref: subscription.subscriptions.plan_id > subscription.plans.id
Ref: subscription.payments.subscription_id > subscription.subscriptions.id
Ref: subscription.refunds.payment_id > subscription.payments.id
Ref: subscription.invoices.subscription_id > subscription.subscriptions.id
Ref: subscription.invoices.payment_id > subscription.payments.id
Ref: subscription.credit_transactions.subscription_id > subscription.subscriptions.id
Ref: subscription.credit_balance_snapshots.subscription_id > subscription.subscriptions.id
Ref: subscription.usage_records.subscription_id > subscription.subscriptions.id

// ═══════════════════════════════════════════════════════════════════════════
// 7. NOTIFICATION SERVICE (`notification`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Notification {
  notification.notification_messages
  notification.admin_notifications
  notification.notifications
  notification.notification_campaigns
  notification.email_delivery_logs
  notification.push_subscriptions
  notification.push_delivery_logs
  notification.notification_preferences
  notification.notification_templates
  notification.inbox_messages
}

Table notification.notification_messages {
  id uuid [pk]
  recipient_user_id uuid [not null]
  title varchar(255) [not null]
  body text [not null]
  notification_type varchar(50) [not null]
  is_read boolean [not null, default: false]
  read_at timestamptz
  created_at timestamptz [not null]
}

Table notification.admin_notifications {
  id uuid [pk]
  title varchar(255) [not null]
  message text [not null]
  target_role varchar(50)
  created_at timestamptz [not null]
  created_by uuid
}

Table notification.notifications {
  id uuid [pk]
  recipient_user_id uuid [not null]
  campaign_id uuid
  title varchar(255) [not null]
  content text [not null]
  channel varchar(20) [not null, default: 'in_app']
  status varchar(20) [not null, default: 'queued']
  sent_at timestamptz
  created_at timestamptz [not null]
}

Table notification.notification_campaigns {
  id uuid [pk]
  name varchar(150) [not null]
  description text
  template_id uuid
  status varchar(20) [not null, default: 'draft']
  scheduled_at timestamptz
  created_at timestamptz [not null]
  created_by uuid
}

Table notification.email_delivery_logs {
  id uuid [pk]
  notification_id uuid [not null]
  recipient_email varchar(320) [not null]
  status varchar(20) [not null]
  provider_message_id varchar(255)
  error_message text
  sent_at timestamptz [not null]
}

Table notification.push_subscriptions {
  id uuid [pk]
  user_id uuid [not null]
  endpoint text [not null]
  p256dh_key text [not null]
  auth_key text [not null]
  device_type varchar(50)
  created_at timestamptz [not null]
}

Table notification.push_delivery_logs {
  id uuid [pk]
  notification_id uuid [not null]
  subscription_id uuid [not null]
  status varchar(20) [not null]
  error_message text
  sent_at timestamptz [not null]
}

Table notification.notification_preferences {
  id uuid [pk]
  user_id uuid [not null, unique]
  email_notifications_enabled boolean [not null, default: true]
  push_notifications_enabled boolean [not null, default: true]
  in_app_notifications_enabled boolean [not null, default: true]
  updated_at timestamptz [not null]
}

Table notification.notification_templates {
  id uuid [pk]
  code varchar(100) [not null, unique]
  subject varchar(255) [not null]
  body_template text [not null]
  channel varchar(20) [not null, default: 'email']
  created_at timestamptz [not null]
}

Table notification.inbox_messages {
  id uuid [pk]
  event_id uuid [not null, unique]
  event_type varchar(150) [not null]
  payload_json jsonb [not null]
  processed_at timestamptz [not null]
}

// Notification Intra-Group FKs
Ref: notification.notifications.campaign_id > notification.notification_campaigns.id
Ref: notification.notification_campaigns.template_id > notification.notification_templates.id
Ref: notification.email_delivery_logs.notification_id > notification.notifications.id
Ref: notification.push_delivery_logs.notification_id > notification.notifications.id
Ref: notification.push_delivery_logs.subscription_id > notification.push_subscriptions.id

// ═══════════════════════════════════════════════════════════════════════════
// 8. ASSISTANT SERVICE (`assistant`)
// ═══════════════════════════════════════════════════════════════════════════

TableGroup Assistant {
  assistant.assistant_conversations
  assistant.assistant_messages
  assistant.assistant_tool_calls
}

Table assistant.assistant_conversations {
  id uuid [pk]
  workspace_id uuid [not null]
  user_id uuid [not null]
  title varchar(255) [not null]
  model varchar(100) [not null, default: 'gpt-4o']
  status varchar(20) [not null, default: 'active']
  created_at timestamptz [not null]
  updated_at timestamptz
}

Table assistant.assistant_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  role varchar(20) [not null]
  content text [not null]
  tokens_used integer
  created_at timestamptz [not null]
}

Table assistant.assistant_tool_calls {
  id uuid [pk]
  message_id uuid [not null]
  tool_name varchar(100) [not null]
  arguments_json jsonb [not null]
  result_json jsonb
  status varchar(20) [not null, default: 'completed']
  created_at timestamptz [not null]
}

// Assistant Intra-Group FKs
Ref: assistant.assistant_messages.conversation_id > assistant.assistant_conversations.id
Ref: assistant.assistant_tool_calls.message_id > assistant.assistant_messages.id

// ═══════════════════════════════════════════════════════════════════════════
// LOGICAL CROSS-DATABASE REFERENCES (BUSINESS & TENANCY LINKS)
// No physical foreign key constraints in PostgreSQL across schemas.
// ═══════════════════════════════════════════════════════════════════════════

// Business Integration Links
Ref: meeting.meeting_rooms.translation_room_id > translation_room.translation_rooms.id
Ref: transcript.transcripts.translation_room_id > translation_room.translation_rooms.id
Ref: transcript.transcripts.translation_room_session_id > translation_room.translation_room_sessions.id
Ref: transcript.transcript_segments.speaker_participant_id > translation_room.translation_room_participants.id
Ref: subscription.usage_records.segment_id > transcript.transcript_segments.id

// Logical Tenancy Links (workspace_id / user_id)
Ref: workspace.workspaces.owner_id > auth.users.id
Ref: workspace.workspace_members.user_id > auth.users.id
Ref: workspace.workspace_members.role_id > auth.roles.id
Ref: voice.voice_profiles.workspace_id > workspace.workspaces.id
Ref: translation_room.translation_rooms.workspace_id > workspace.workspaces.id
Ref: translation_room.translation_rooms.host_id > auth.users.id
Ref: translation_room.translation_room_participants.user_id > auth.users.id
Ref: translation_room.translation_room_series.workspace_id > workspace.workspaces.id
Ref: meeting.meeting_rooms.active_host_id > auth.users.id
Ref: meeting.rtc_stream_participants.user_id > auth.users.id
Ref: meeting.meeting_chat_messages.sender_user_id > auth.users.id
Ref: transcript.transcripts.workspace_id > workspace.workspaces.id
Ref: transcript.translation_contents.workspace_id > workspace.workspaces.id
Ref: transcript.glossaries.workspace_id > workspace.workspaces.id
Ref: subscription.subscriptions.workspace_id > workspace.workspaces.id
Ref: subscription.subscriptions.user_id > auth.users.id
Ref: subscription.workspace_entitlement_overrides.workspace_id > workspace.workspaces.id
Ref: notification.notifications.recipient_user_id > auth.users.id
Ref: assistant.assistant_conversations.workspace_id > workspace.workspaces.id
Ref: assistant.assistant_conversations.user_id > auth.users.id
