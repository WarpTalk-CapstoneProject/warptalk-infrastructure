global:
  smtp_smarthost: __SMTP_SMARTHOST__
  smtp_from: __SMTP_FROM_EMAIL__
  smtp_auth_username: __SMTP_USERNAME__
  smtp_auth_password: __SMTP_PASSWORD__
  smtp_require_tls: true

route:
  receiver: warptalk-operations
  group_by: [alertname, service_name, queue, stream]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: warptalk-operations
    email_configs:
      - to: __ALERT_EMAIL_TO__
        send_resolved: true
